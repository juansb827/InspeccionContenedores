<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/galleryRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gallery_surface">
    <LinearLayout android:id="@+id/galleryToolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical"
        android:background="@color/AzulF" android:paddingEnd="8dp">
        <ImageButton android:id="@+id/galleryBack"
            android:layout_width="56dp" android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_gallery_back" android:contentDescription="@string/gallery_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingVertical="8dp">
            <TextView android:id="@+id/galleryTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/gallery_title"
                android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/galleryContext" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/galleryDelete" android:layout_width="48dp"
            android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_gallery_delete" android:visibility="gone"
            android:contentDescription="@string/gallery_delete" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/galleryGrid"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="4dp" android:clipToPadding="false" />
        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/galleryPager"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:background="@color/gallery_viewer" />
        <TextView android:id="@+id/galleryEmpty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:padding="32dp"
            android:text="@string/gallery_empty" android:textSize="18sp"
            android:textColor="@color/gallery_text" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/galleryDeleting" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:padding="12dp"
        android:text="@string/gallery_deleting" android:textColor="@android:color/white"
        android:background="@color/gallery_viewer" android:visibility="gone"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
